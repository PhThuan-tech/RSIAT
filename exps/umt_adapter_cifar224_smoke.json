{
    "prefix": "umt_weak_moment_topk_smoke",
    "dataset": "cifar224",
    "resume": false,
    "isolate_runs": true,
    "keep_last_checkpoint": true,
    "compact_diagonal_checkpoint": true,
    "shuffle": true,
    "ssca": false,
    "ca": true,
    "init_cls": 10,
    "increment": 10,
    "model_name": "umt_adapter",
    "convnet_type": "pretrained_vit_b16_224_in21k_adapter",
    "device": ["0"],
    "seed": [1993],

    "init_epochs": 1,
    "warmup_epoch": 1,
    "inc_epochs": 1,
    "ca_epochs": 1,
    "eval_interval": 0,
    "ca_eval_interval": 0,
    "init_lr": 0.018461273665041644,
    "batch_size": 16,
    "weight_decay": 0.0001714081878951529,
    "min_lr": 0,
    "ffn_num": 64,
    "optimizer": "sgd",

    "scale": 40.0,
    "margin": 0.1,
    "alpha": 0.5,
    "rs_margin": 0.3,
    "lambda_rs": 0.2,
    "beta": 1.0,
    "gamma": 0.4,

    "projector_type": "weakly_nonlinear",
    "projector_rank": 16,
    "projector_hidden_dim": 64,
    "projector_dropout": 0.0,
    "projector_reset_each_task": true,
    "linear_gate_init": 0.5,
    "nonlinear_gate_init": 0.1,
    "projector_lr": 0.001,
    "projector_weight_decay": 0.0001,
    "ae_code_dims": 256,
    "ae_init_lr": 0.0005611742230603744,
    "ae_weight_decay": 0.0029339295871570244,

    "point_weight": 1.0,
    "mean_weight": 0.1,
    "variance_weight": 0.01,
    "complexity_weight": 0.001,
    "moment_classwise": true,

    "separation_weight": 0.4,
    "separation_topk": 10,
    "separation_threshold_min": 0.1,
    "separation_threshold_max": 0.5,

    "prototype_transport": true,
    "statistics_transport": "diagonal_mc",
    "statistics_transport_samples": 32,
    "statistics_epsilon": 0.0001
}
